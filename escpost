#!/bin/sh

set -eu

project_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_directory"

# Docker creates a missing bind-mount source as root. Create the selected
# source as the host user so ESCPost can update it.
config_directory=${ESCPOST_CONFIG_HOST_DIR:-"$project_directory/local/config"}
mkdir -p "$config_directory"

# The container mounts this directory at its own conventional path, so let the
# containerized binary print the host directory instead of that mount target.
ESCPOST_CONFIG_DISPLAY_DIR=$(CDPATH= cd -- "$config_directory" && pwd)
export ESCPOST_CONFIG_DISPLAY_DIR

exec docker compose run --rm cli "$@"
