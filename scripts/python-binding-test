#!/usr/bin/env bash
#
# Build the PyO3 render binding and run the Python binding tests. Like the
# `./escpost` wrapper, this runs from the host and does its work inside the
# development container, which has `maturin` and `python3`.
#
# Usage:
#   scripts/python-binding-test [unittest arguments...]
#
set -euo pipefail

project_directory=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_directory"

# Inside the container: build the binding into the workspace virtualenv, then
# run the binding tests. Any host arguments are forwarded to unittest.
exec docker compose run --rm test sh -c '
    set -eu
    virtual_environment=/workspace/.venv
    if [ ! -x "$virtual_environment/bin/python" ]; then
        python3 -m venv "$virtual_environment"
    fi
    export VIRTUAL_ENV="$virtual_environment"
    export PATH="$virtual_environment/bin:$PATH"
    maturin develop --quiet --locked
    exec python -m unittest discover -s python/tests "$@"
' python-binding-test "$@"
