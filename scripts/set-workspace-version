#!/usr/bin/env python3

import os
import re
import stat
import sys
import tempfile
import tomllib
from pathlib import Path


VERSION = re.compile(r"^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$")
DEPENDENCIES = ("escpost-profiles", "escpost-render")


def replace_once(text: str, pattern: str, version: str, description: str) -> str:
    matches = list(re.finditer(pattern, text, flags=re.MULTILINE))
    if len(matches) != 1:
        raise ValueError(f"expected one {description}, found {len(matches)}")
    return re.sub(
        pattern,
        lambda match: f'{match.group(1)}{version}{match.group(2)}',
        text,
        count=1,
        flags=re.MULTILINE,
    )


def updated_manifest(text: str, version: str) -> str:
    manifest = tomllib.loads(text)
    workspace = manifest.get("workspace", {})
    package = workspace.get("package", {})
    dependencies = workspace.get("dependencies", {})
    if "version" not in package:
        raise ValueError("workspace.package.version is missing")
    for dependency in DEPENDENCIES:
        specification = dependencies.get(dependency)
        if not isinstance(specification, dict) or "version" not in specification:
            raise ValueError(f"workspace dependency {dependency} has no version")

    text = replace_once(
        text,
        r'^(version\s*=\s*")[^"]+("\s*)$',
        version,
        "workspace package version",
    )
    for dependency in DEPENDENCIES:
        text = replace_once(
            text,
            rf'^({re.escape(dependency)}\s*=\s*\{{[^}}\n]*\bversion\s*=\s*")[^"]+("[^}}\n]*\}}\s*)$',
            version,
            f"{dependency} version requirement",
        )
    tomllib.loads(text)
    return text


def write_atomically(path: Path, text: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    descriptor, temporary_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(descriptor, "w") as temporary:
            temporary.write(text)
        os.chmod(temporary_name, mode)
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    if len(sys.argv) != 2 or VERSION.fullmatch(sys.argv[1]) is None:
        print("usage: set-workspace-version <major.minor.patch>", file=sys.stderr)
        return 2

    manifest_path = Path(__file__).resolve().parent.parent / "Cargo.toml"
    try:
        text = updated_manifest(manifest_path.read_text(), sys.argv[1])
        write_atomically(manifest_path, text)
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"could not set workspace version: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
